DIRECT_DATABASE_URL=postgresql://postgres.yezeyzqalpiefanrosws:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# NextAuth
# Generate a new secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Keldatagh
NODE_ENV=development

# Supabase
# Update with your actual Supabase project URL and anon key from Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://yezeyzqalpiefanrosws.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Providers (Optional - can be set in Admin → Payment Settings)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
MOOLRE_API_USER=
