{
  "info": {
    "name": "GhBundle Reseller API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for GhBundle reseller API with HMAC request signing."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const apiKey = pm.environment.get('apiKey');",
          "const apiSecret = pm.environment.get('apiSecret');",
          "if (!apiKey || !apiSecret) {",
          "  throw new Error('Set apiKey and apiSecret in your environment.');",
          "}",
          "const method = pm.request.method.toUpperCase();",
          "const path = pm.request.url.getPathWithQuery();",
          "const rawBody = pm.request.body && pm.request.body.mode === 'raw' ? (pm.request.body.raw || '') : '';",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const nonce = Math.random().toString(36).slice(2) + Date.now().toString(36);",
          "const payload = [method, path, rawBody, timestamp, nonce].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(payload, apiSecret).toString(CryptoJS.enc.Hex);",
          "pm.variables.set('timestamp', timestamp);",
          "pm.variables.set('nonce', nonce);",
          "pm.variables.set('signature', signature);",
          "pm.request.headers.upsert({ key: 'X-API-KEY', value: apiKey });",
          "pm.request.headers.upsert({ key: 'X-TIMESTAMP', value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-NONCE', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-SIGNATURE', value: signature });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ghbundle.com/api/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "apiSecret",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "webhookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Services",
      "item": [
        {
          "name": "List Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "balance"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": \"cmabc123\",\n  \"phone\": \"233245001122\",\n  \"qty\": 1,\n  \"client_order_id\": \"agent-order-{{timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.order_id) pm.environment.set('orderId', json.order_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Subscribe Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://agent.example.com/webhooks/ghbundle\",\n  \"events\": [\"order.updated\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.environment.set('webhookId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks"
              ]
            }
          }
        },
        {
          "name": "Delete Webhook",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/{{webhookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "{{webhookId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
